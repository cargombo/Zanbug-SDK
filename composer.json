{
    "name": "zanbug/laravel",
    "description": "Zanbug SDK for Laravel — captures exceptions, validation errors and slow queries",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zahid Həsənzadə",
            "email": "zahid.hzade001@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Zanbug\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zanbug\\Laravel\\ZanbugServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
