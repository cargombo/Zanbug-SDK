{
    "name": "zanbug/laravel",
    "description": "Zanbug SDK for Laravel — captures exceptions, validation errors and slow queries",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Zahid Həsənzadə",
            "email": "zahid.hzade001@gmail.com"
        }
    ],
    "require": {
        "php": ">=5.6",
        "illuminate/support": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Zanbug\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zanbug\\Laravel\\ZanbugServiceProvider"
            ],
            "aliases": {
                "Zanbug": "Zanbug\\Laravel\\Zanbug"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
